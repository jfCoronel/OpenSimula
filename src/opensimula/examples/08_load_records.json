{
    "name": "08 Load records",
    "description": "The DX system of example 06 serving the office defined only by its loads: a record of the hourly loads of the box replaces the building",
    "time_step": 3600,
    "n_time_steps": 8760,
    "initial_time": "01/01/2001 00:00:00",
    "simulation_file_met": "sevilla",
    "components": [
        {
            "type": "Day_schedule",
            "name": "working_day",
            "description": "Office hours: 0 until 8:00, 1 from 8:00 to 18:00, 0 after",
            "time_steps": [
                28800,
                36000
            ],
            "values": [
                0,
                1,
                0
            ],
            "interpolation": "STEP"
        },
        {
            "type": "Day_schedule",
            "name": "closed_day",
            "description": "Closed all day",
            "time_steps": [],
            "values": [
                0
            ],
            "interpolation": "STEP"
        },
        {
            "type": "Week_schedule",
            "name": "working_week",
            "description": "Monday to Friday open, Saturday and Sunday closed",
            "days_schedules": [
                "working_day",
                "working_day",
                "working_day",
                "working_day",
                "working_day",
                "closed_day",
                "closed_day"
            ]
        },
        {
            "type": "Week_schedule",
            "name": "holiday_week",
            "description": "Closed all week",
            "days_schedules": [
                "closed_day"
            ]
        },
        {
            "type": "Year_schedule",
            "name": "office_hours",
            "description": "Working weeks all year except August (holidays). Its variable 'values' is 1 when the office is open",
            "periods": [
                "01/08",
                "01/09"
            ],
            "weeks_schedules": [
                "working_week",
                "holiday_week",
                "working_week"
            ]
        },
        {
            "type": "File_met",
            "name": "sevilla",
            "description": "Hourly weather of Sevilla (Spain), MET format. The file is read from the folder the app is started from",
            "file_type": "MET",
            "file_name": "sevilla.met"
        },
        {
            "type": "File_data",
            "name": "load_record",
            "description": "Hourly sensible and latent loads of the box of the examples (one row per hour, positive heating), calculated with the ideal system of example 05 holding 24 °C and 50 % all year, with no outdoor air and 0.5 air changes per hour; file_step ANNUAL: the rows are the hours of the year from 1 January, read by the date of each time step",
            "file_name": "office_loads.csv",
            "file_step": "ANNUAL"
        },
        {
            "type": "Load_space",
            "name": "office",
            "description": "The office, defined by its load record instead of by its walls and windows. The record was calculated with 0.5 ach; the infiltration is only there while the office is closed, as in examples 05-07. The box is very light (the ASHRAE 140 lightweight case), lighter than the ISO 13790 classes: its effective mass is given as CUSTOM",
            "input_variables": [
                "Q = load_record.Q_sensible",
                "L = load_record.Q_latent",
                "f = office_hours.values"
            ],
            "sensible_load": "Q",
            "latent_load": "L",
            "reference_temperature": "24",
            "reference_humidity": "50",
            "load_infiltration": "0.5",
            "infiltration": "0.5 * (1 - f)",
            "floor_area": 48,
            "height": 2.7,
            "construction": "CUSTOM",
            "custom_mass_capacity": 20,
            "custom_mass_area": 1.0,
            "envelope_conductance": 1.8
        },
        {
            "type": "Calculator",
            "name": "degree_hours",
            "description": "Heating and cooling degree-hours, base 18 °C and 25 °C, from the outdoor temperature",
            "input_variables": [
                "T = sevilla.temperature"
            ],
            "output_variables": [
                "heating_degree_hours",
                "cooling_degree_hours"
            ],
            "output_units": [
                "K·h",
                "K·h"
            ],
            "output_expressions": [
                "max(18 - T, 0)",
                "max(T - 25, 0)"
            ]
        },
        {
            "type": "Calculator",
            "name": "loads",
            "description": "Heating and cooling load of the office in kW, both positive: with hourly steps, their monthly sum is the energy in kWh",
            "input_variables": [
                "Q = office.system_sensible_heat"
            ],
            "output_variables": [
                "heating_load",
                "cooling_load"
            ],
            "output_units": [
                "kW",
                "kW"
            ],
            "output_expressions": [
                "max(Q, 0) / 1000",
                "max(-Q, 0) / 1000"
            ]
        },
        {
            "type": "DX_unit",
            "name": "heat_pump",
            "description": "Air-to-air heat pump: rated capacities and their curves with the indoor and outdoor conditions; at part load it cycles on and off, which lowers its EER and COP by 15 % x (1 - F_load)",
            "nominal_air_flow": 0.417,
            "nominal_total_cooling_capacity": 6900,
            "nominal_sensible_cooling_capacity": 4800,
            "nominal_cooling_power": 2400,
            "indoor_fan_power": 240,
            "total_cooling_capacity_expression": "0.88078 + 0.014248 * T_iwb + 0.00055436 * T_iwb**2 - 0.0075581 * T_odb + 3.2983E-05 * T_odb**2 - 0.00019171 * T_odb * T_iwb",
            "sensible_cooling_capacity_expression": "0.50060 - 0.046438 * T_iwb - 0.00032472 * T_iwb**2 - 0.013202 * T_odb + 7.9307E-05 * T_odb**2 + 0.069958 * T_idb - 3.4276E-05 * T_idb**2",
            "cooling_power_expression": "0.11178 + 0.028493 * T_iwb - 0.00041116 * T_iwb**2 + 0.021414 * T_odb + 0.00016113 * T_odb**2 - 0.00067910 * T_odb * T_iwb",
            "EER_expression": "0.85 + 0.15 * F_load",
            "nominal_heating_capacity": 6500,
            "nominal_heating_power": 2825,
            "heating_capacity_expression": "0.81474 + 0.030682602 * T_owb + 3.2303E-05 * T_owb**2",
            "heating_power_expression": "1.2012 - 0.040063 * T_owb + 0.0010877 * T_owb**2",
            "COP_expression": "0.85 + 0.15 * F_load"
        },
        {
            "type": "HVAC_DX_system",
            "name": "dx_system",
            "description": "Single-zone system with the heat pump, working while the office is open: 20-25 °C and 15 % of outdoor air",
            "spaces": "office",
            "equipment": "heat_pump",
            "air_flow": 0.417,
            "input_variables": [
                "f = office_hours.values"
            ],
            "outdoor_air_fraction": "0.15",
            "heating_setpoint": "20",
            "cooling_setpoint": "25",
            "system_on_off": "f"
        }
    ]
}
